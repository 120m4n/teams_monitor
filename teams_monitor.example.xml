<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to teams_monitor.xml next to teams_monitor.exe (gitignored: it holds the WiFi password).
     The app reads it at startup; command-line flags override it. deploy\flash.ps1 reads <wifi> and the port. -->
<teamsMonitor>
  <!-- Executables whose microphone session means "in a call". Omit to use these defaults. -->
  <processes>
    <exe>ms-teams.exe</exe>
    <exe>Teams.exe</exe>
    <exe>msteams.exe</exe>
  </processes>

  <!-- mode: serial (USB), http (WiFi) or both. The serial port is also the one flash.ps1 uploads through. -->
  <actuator mode="serial">
    <serial port="COM16" baud="115200"/>
  </actuator>

  <!-- 2.4 GHz network. ip is flashed as the board's static IP and the app posts to http://<ip>/led.
       Pick an address outside the router's DHCP range. Without ssid the firmware is serial-only. -->
  <wifi ssid="your-2.4GHz-ssid" password="your-password" ip="192.168.1.50" gateway="192.168.1.1" subnet="255.255.255.0"/>

  <!-- Force an LED effect during calls (0 fade-in, 1 clock, 2 voice, 3 scanner, 4 disco); -1 follows call length. -->
  <fx>-1</fx>

  <!-- One-button page that lets teammates flash the ring, published with Tailscale Funnel (docs/INSTALL.md).
       Keep listen on 127.0.0.1. cooldown: seconds between pings from one client. duration: seconds one ping
       plays (1-60). fx: default effect (0 fade-in, 1 clock, 2 voice, 3 scanner, 4 disco). pickfx: teammates may
       pick the effect from a menu (true/false). name: whose ring it is, shown on the page (read at startup:
       restart the app to change it). Omit the element to disable the page. -->
  <web listen="127.0.0.1:8080" cooldown="30" duration="5" fx="4" pickfx="true" name="Germán"/>
</teamsMonitor>
