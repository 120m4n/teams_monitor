<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to teams_monitor.xml next to teams_monitor.exe (gitignored: it holds the WiFi password).
     The app reads it at startup; command-line flags override it. deploy\flash.ps1 reads <wifi> and the port. -->
<teamsMonitor>
  <!-- Executables whose microphone session means "in a call". Omit to use these defaults. -->
  <processes>
    <exe>ms-teams.exe</exe>
    <exe>Teams.exe</exe>
    <exe>msteams.exe</exe>
  </processes>

  <!-- mode: serial (USB), http (WiFi) or both. The serial port is also the one flash.ps1 uploads through. -->
  <actuator mode="serial">
    <serial port="COM16" baud="115200"/>
  </actuator>

  <!-- 2.4 GHz network. ip is flashed as the board's static IP and the app posts to http://<ip>/led.
       Pick an address outside the router's DHCP range. Without ssid the firmware is serial-only. -->
  <wifi ssid="your-2.4GHz-ssid" password="your-password" ip="192.168.1.50" gateway="192.168.1.1" subnet="255.255.255.0"/>

  <!-- Force an LED effect during calls (0 fade-in, 1 clock, 2 voice, 3 scanner, 4 disco,
       5 siren, 6 heartbeat, 7 pacman, 8 roulette, 9 fire, 10 comet); -1 follows call length. -->
  <fx>-1</fx>

  <!-- Teammate ping page, published with Tailscale Funnel (docs/INSTALL.md). Omit the element to disable it.
       Read at startup: restart the app after changing anything here. -->
  <web
    listen="127.0.0.1:8080"
    cooldown="30"
    duration="5"
    fx="4"
    pickfx="true"
    name="your-name"
    timezone="America/Bogota"/>
  <!-- listen:   address the page is served on; keep it on 127.0.0.1 so only the tunnel reaches it
       cooldown: seconds between pings from one client
       duration: seconds one ping plays on the ring (1-60); the queue waits this long per ping
       fx:       default ping effect, same numbers as <fx> above (0-10)
       pickfx:   true shows an effect menu on the page; false always uses fx
       name:     whose ring it is, shown on the page ("El aro de ...")
       timezone: IANA zone (e.g. America/Bogota, UTC-5); a visitor's nick expires at its midnight -->
</teamsMonitor>
